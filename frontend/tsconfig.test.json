{
  // Test files run in Node (or jsdom), so they get Node's types; app code
  // does not, which keeps browser code from accidentally using Node APIs.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": []
}

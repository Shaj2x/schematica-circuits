# Copy to .env and fill in. .env is git-ignored; never commit real keys.
DATABASE_URL=postgresql+psycopg://schematica:schematica@localhost:5432/schematica

# Optional. Without it, explanations come from the deterministic template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Photo recognition: path to the trained detector. Defaults to ml/weights/model.onnx;
# when the file is missing, photo upload is off and the rest of the API works.
# MODEL_PATH=/models/model.onnx

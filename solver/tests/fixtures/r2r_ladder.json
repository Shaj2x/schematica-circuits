        "value": 1000
      },
      {
        "id": "R4",
        "type": "resistor",
        "a": "n2",
        "b": "gnd",
        "value": 2000
      },
      {
        "id": "R5",
        "type": "resistor",
        "a": "n2",
        "b": "n3",
        "value": 1000
      },
      {
        "id": "R6",
        "type": "resistor",
        "a": "n3",
        "b": "gnd",
        "value": 2000
      },
      {

{
  "name": "wheatstone_balanced",
  "description": "Balanced Wheatstone bridge: R1/R2 = R3/R4, so no current flows through the 500 \u03a9 bridge resistor.",
  "derivation": "Each arm is a divider: v_a = 10 * 1k/2k = 5 V and v_b = 10 * 2k/4k = 5 V. v_a = v_b, so I(R5) = 0. Arm currents are 10/2k = 5 mA and 10/4k = 2.5 mA, 7.5 mA in total.",
  "netlist": {
    "version": 1,
    "ground": "gnd",
    "components": [
      {
        "id": "V1",
        "type": "voltage_source",
        "pos": "top",
        "neg": "gnd",
        "value": 10
      },
      {
        "id": "R1",
        "type": "resistor",
        "a": "top",
        "b": "a",
        "value": 1000
      },
      {
        "id": "R2",
        "type": "resistor",
        "a": "a",
        "b": "gnd",
        "value": 1000
      },
      {
        "id": "R3",
        "type": "resistor",
        "a": "top",
        "b": "b",
        "value": 2000
      },
      {
        "id": "R4",
        "type": "resistor",
        "a": "b",
        "b": "gnd",
        "value": 2000
      },
      {
        "id": "R5",
        "type": "resistor",
        "a": "a",
        "b": "b",
        "value": 500
      }
    ]
  },
  "expected": {
    "node_voltages": {
      "gnd": 0.0,
      "top": 10.0,
      "a": 5.0,
      "b": 5.0
    },
    "branch_currents": {
      "V1": -0.0075,
      "R1": 0.005,
      "R2": 0.005,
      "R3": 0.0025,
      "R4": 0.0025,
      "R5": 0.0
    }
  }
}
